<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>et.elisa</groupId>
  <artifactId>elisa</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>sip-freeswitch :: Elisa edge</name>
  <description>High-CPS SIP edge (Quarkus + micro-jainslee + ra-sip-servlet). Trunk toward FreeSWITCH dialplan/media lab. Target 10k INVITE/s.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <quarkus.platform.version>3.37.3</quarkus.platform.version>
    <microjainslee.version>1.2.2-SNAPSHOT</microjainslee.version>
    <surefire.version>3.5.4</surefire.version>
    <enforcer.plugin.version>3.5.0</enforcer.plugin.version>
    <!-- Log4j2-only policy (owner mandate 2026-08-26): one version family for
         api/core + all bridges; bom imported BEFORE quarkus-bom so it wins. -->
    <log4j2.version>2.26.1</log4j2.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BEFORE quarkus-bom — see log4j2.version above. -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Infinispan 15 expects protostream 5.x (Quarkus BOM pulls 6.x). -->
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream</artifactId>
        <version>5.0.1.Final</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream-types</artifactId>
        <version>5.0.1.Final</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
      <exclusions>
        <!-- Log4j2-only policy: no slf4j→jboss bridge. jboss-logmanager itself is
             a STRUCTURAL requirement of the Quarkus fast-jar entrypoint and stays
             SILENT because every real route is forced into Log4j2:
             JUL → log4j-jul · slf4j → log4j-slf4j2-impl · log4j1 API → log4j-1.2-api
             · jboss-logging facade → -Dorg.jboss.logging.provider=log4j2 -->
        <exclusion><groupId>org.jboss.slf4j</groupId><artifactId>slf4j-jboss-logmanager</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>
    <!-- Log4j2-only policy: the ONLY active backend + its facade bridges.
         jboss-logmanager (transitive via Quarkus) stays silent — see run.sh flags. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-jul</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-1.2-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-core</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-cluster</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-api</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <!-- 3GPP AuC: MILENAGE (TS 35.206/208), TS 33.102 Annex C SQN, AUTS, quintuplets.
           Only the pure crypto classes are used; epc-api (and its ra-gtpv2c) must never
           enter the Elisa JVM (AGENTS: no GTP in Elisa). -->
      <groupId>et.epc</groupId>
      <artifactId>epc-crypto</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>et.epc</groupId>
          <artifactId>epc-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- Multi-tenant RBAC: platform-admin (ADMIN) > tenant-admin (GD) > user (USER) -->
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-authz</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-apt</artifactId>
      <version>${microjainslee.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>adapter-quarkus</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-sip-servlet</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-diameter</artifactId>
      <version>${microjainslee.version}</version>
      <exclusions>
        <!-- Log4j2-only policy: jdiameter/sctp legacy log4j1 backends banned —
             their slf4j/log4j1 calls route into Log4j2 via the bridge jars. -->
        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-log4j12</artifactId></exclusion>
        <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-freeswitch</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-telemetry</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <version>1.14.0</version>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-prometheus-exporter</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>0.10.2</version>
    </dependency>
    <dependency>
      <groupId>org.infinispan</groupId>
      <artifactId>infinispan-core</artifactId>
      <version>15.0.0.Final</version>
    </dependency>
    <dependency>
      <groupId>org.infinispan</groupId>
      <artifactId>infinispan-commons</artifactId>
      <version>15.0.0.Final</version>
    </dependency>
    <dependency>
      <groupId>org.infinispan.protostream</groupId>
      <artifactId>protostream</artifactId>
    </dependency>
    <dependency>
      <groupId>org.infinispan.protostream</groupId>
      <artifactId>protostream-types</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>org.jboss.slf4j</groupId><artifactId>slf4j-jboss-logmanager</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>25</release>
          <annotationProcessorPaths>
            <path>
              <groupId>com.microjainslee</groupId>
              <artifactId>jainslee-api</artifactId>
              <version>${microjainslee.version}</version>
            </path>
            <path>
              <groupId>com.microjainslee</groupId>
              <artifactId>jainslee-apt</artifactId>
              <version>${microjainslee.version}</version>
            </path>
            <path>
              <groupId>org.apache.logging.log4j</groupId>
              <artifactId>log4j-api</artifactId>
              <version>${log4j2.version}</version>
            </path>
            <path>
              <groupId>org.apache.logging.log4j</groupId>
              <artifactId>log4j-core</artifactId>
              <version>${log4j2.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <systemPropertyVariables>
            <!-- Log4j2-only: JUL routes into Log4j2 (log4j-jul); the jboss-logging
                 facade pinned to its Log4j2 provider despite jboss-logmanager
                 being present as the Quarkus-entrypoint structural jar. -->
            <java.util.logging.manager>org.apache.logging.log4j.jul.LogManager</java.util.logging.manager>
            <org.jboss.logging.provider>log4j2</org.jboss.logging.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-java-25-and-log4j2-only</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,26)</version>
                  <message>elisa requires JDK 25 only. Use mise zulu-25.</message>
                </requireJavaVersion>
                <bannedDependencies>
                  <excludes>
                    <!-- Log4j2-only policy (owner mandate 2026-08-26): every log event
                         must flow through Log4j2. Legacy backends and cross-facade
                         bridges are banned; jboss-logmanager is the one Quarkus-
                         entrypoint structural exception (silent) — enforced via the
                         source-scan test + org.jboss.logging.provider=log4j2. -->
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>ch.qos.reload4j:reload4j</exclude>
                    <exclude>org.jboss.slf4j:slf4j-jboss-logmanager</exclude>
                    <exclude>commons-logging:commons-logging</exclude>
                  </excludes>
                  <message>Log4j2-only policy violation: a forbidden logging backend was resolved. Route the facade into Log4j2 (log4j-slf4j2-impl / log4j-jul / log4j-1.2-api) instead.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
