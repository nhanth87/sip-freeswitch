<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>et.epc</groupId>
  <artifactId>epc-core</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>epc-core</name>
  <description>4G Full MVNO EPC — HSS/AuC, SGW-C/U, PGW-C/U. Not Elisa. Not an MME. Not DRA/STP.</description>

    <modules>
    <module>epc-api</module>
    <module>epc-crypto</module>
    <module>epc-hss</module>
    <module>epc-sgwc</module>
    <module>epc-pgwc</module>
    <module>epc-pcef</module>
    <module>epc-pcrf</module>
    <module>epc-up-linux</module>
    <module>epc-host</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <microjainslee.version>1.2.0-SNAPSHOT</microjainslee.version>
    <junit.version>5.11.4</junit.version>
    <log4j.version>2.26.1</log4j.version>
    <surefire.version>3.5.4</surefire.version>
    <compiler.plugin.version>3.14.0</compiler.plugin.version>
    <enforcer.plugin.version>3.5.0</enforcer.plugin.version>
    <infinispan.version>15.0.0.Final</infinispan.version>
    <protostream.version>5.0.1.Final</protostream.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-crypto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-hss</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>ra-gtpv2c</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>ra-pfcp</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-pcef</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-pcrf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-sgwc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-pgwc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-up-linux</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>et.epc</groupId>
        <artifactId>epc-host</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-api</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-core</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-cluster</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-apt</artifactId>
        <version>${microjainslee.version}</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>jainslee-ra-spi</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>adapter-quarkus</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>ra-diameter</artifactId>
        <version>${microjainslee.version}</version>
        <exclusions>
          <!-- Log4j2-only policy (owner mandate 2026-08-26): jdiameter/sctp legacy
               log4j1 backends banned reactor-wide — their slf4j/log4j1 calls route
               into Log4j2 via the inherited bridge jars (log4j-slf4j2-impl /
               log4j-1.2-api). jboss-logmanager stays the silent Quarkus jar. -->
          <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-log4j12</artifactId></exclusion>
          <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-core</artifactId>
        <version>${infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan</groupId>
        <artifactId>infinispan-commons</artifactId>
        <version>${infinispan.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream</artifactId>
        <version>${protostream.version}</version>
      </dependency>
      <dependency>
        <groupId>org.infinispan.protostream</groupId>
        <artifactId>protostream-types</artifactId>
        <version>${protostream.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <!-- Log4j2-only policy bridges: JUL + slf4j route INTO Log4j2;
           jboss-logmanager stays a silent Quarkus structural jar (epc-host). -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-jul</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>25</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <systemPropertyVariables>
              <!-- Log4j2-only policy: JUL routes into Log4j2 (log4j-jul);
                   jboss-logging facade pinned to the Log4j2 provider. -->
              <java.util.logging.manager>org.apache.logging.log4j.jul.LogManager</java.util.logging.manager>
              <org.jboss.logging.provider>log4j2</org.jboss.logging.provider>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-java-25</id>
              <goals><goal>enforce</goal></goals>
              <configuration>
                <rules>
                  <requireJavaVersion>
                    <version>[25,26)</version>
                  </requireJavaVersion>
                  <bannedDependencies>
                    <excludes>
                      <!-- Log4j2-only policy (owner mandate 2026-08-26). -->
                      <exclude>log4j:log4j</exclude>
                      <exclude>org.slf4j:slf4j-log4j12</exclude>
                      <exclude>ch.qos.reload4j:reload4j</exclude>
                      <exclude>org.jboss.slf4j:slf4j-jboss-logmanager</exclude>
                      <exclude>commons-logging:commons-logging</exclude>
                    </excludes>
                    <message>Log4j2-only policy violation: a forbidden logging backend was resolved.</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Inherited by every module: Log4j2-only bridge jars so the surefire
       java.util.logging.manager / org.jboss.logging.provider routing always
       has its provider on the classpath. -->
  <dependencies>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-jul</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
    </dependency>
  </dependencies>
</project>
