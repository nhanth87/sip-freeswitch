<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>et.epc</groupId>
    <artifactId>epc-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>epc-hss</artifactId>
  <name>epc :: epc-hss</name>
  <dependencies>
    <dependency>
      <groupId>et.epc</groupId>
      <artifactId>epc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>et.epc</groupId>
      <artifactId>epc-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-diameter</artifactId>
    </dependency>
    <dependency>
      <!-- HLR/AuC face: MAP SendAuthenticationInfo over SS7 (TS 29.002 §8.5.2) -->
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-jss7</artifactId>
      <version>${microjainslee.version}</version>
      <exclusions>
        <!-- Log4j2-only policy: jSS7 stream/sctp-api pull log4j 1.2.8 -->
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- jSS7's org.apache.log4j calls routed into Log4j2 -->
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-1.2-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-apt</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
    <!-- Standalone (HssMain) durable datastore: Postgres JDBC + Flyway on the epc DB.
         optional=true so these never leak into epc-host's transitive set — epc-host
         owns its own Quarkus Agroal/Flyway for the db/migration location. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>12.0.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>12.0.0</version>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
