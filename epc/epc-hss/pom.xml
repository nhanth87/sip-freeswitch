<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>et.epc</groupId>
    <artifactId>epc-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>epc-hss</artifactId>
  <name>epc :: epc-hss</name>
  <dependencyManagement>
    <dependencies>
      <!-- One Jackson line for the whole module. Without it Maven's nearest-wins picks
           jackson-core 2.15.2 from jSS7 tcap-impl (ra-jss7), and Vert.x 4.5.36 JSON fails at
           runtime with NoSuchMethodError BufferRecycler.releaseToPool() (added in 2.16).
           2.21.8 is the version vertx-dependencies 4.5.36 is built against; it also lifts
           flyway's jackson-databind 2.19.1 and jSS7's jackson-dataformat-xml 2.15.2 onto the
           same core/annotations. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>et.epc</groupId>
      <artifactId>epc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>et.epc</groupId>
      <artifactId>epc-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-diameter</artifactId>
    </dependency>
    <dependency>
      <!-- HLR/AuC face: MAP SendAuthenticationInfo over SS7 (TS 29.002 §8.5.2) -->
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-jss7</artifactId>
      <version>${microjainslee.version}</version>
      <exclusions>
        <!-- Log4j2-only policy: jSS7 stream/sctp-api pull log4j 1.2.8 -->
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- UDM face: Nudm-UEAU over HTTP/2 cleartext prior knowledge (TS 29.500 §5.2.2).
           Vert.x 4.5 HTTP server; also supplies io.vertx.core.json (Jackson) used by
           UdmUeauSbb to parse/encode the TS 29.503 JSON bodies. -->
      <groupId>com.microjainslee</groupId>
      <artifactId>ra-http-server</artifactId>
      <version>${microjainslee.version}</version>
    </dependency>
    <dependency>
      <!-- jSS7's org.apache.log4j calls routed into Log4j2 -->
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-1.2-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microjainslee</groupId>
      <artifactId>jainslee-apt</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
    <!-- Standalone (HssMain) durable datastore: Postgres JDBC + Flyway on the epc DB.
         optional=true so these never leak into epc-host's transitive set — epc-host
         owns its own Quarkus Agroal/Flyway for the db/migration location. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>12.0.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>12.0.0</version>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
