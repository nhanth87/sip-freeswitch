# Standalone PCEF (same epc-host image) — policy enforcement/CDR engine, distinct from the
# PGW-C-embedded PCEF. Diameter only (Gx/Gy); no GTP-C/PFCP RA on this node.
EPC_ROLE_HSS=false
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=false
EPC_ROLE_PCRF=false
EPC_ROLE_PCEF=true
EPC_ROLE_UP=false
EPC_CLUSTER_NODE_ID=epc-pcef-1
EPC_CLUSTER_ISPN_MODE=LOCAL
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=5
EPC_HTTP_PORT=8099
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# P1 online charging to OCS over Gy (async CCR->CCA). Off = CDR offline only.
EPC_PCEF_OCS_ENABLED=false