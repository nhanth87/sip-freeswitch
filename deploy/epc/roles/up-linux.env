# UP (GTP-U user plane, epc-up-linux). Control-plane see-through: epc-host up role registers
# no Diameter/GTP-C/PFCP RA — the node is the UP peer peer-evidence only. Kernel GTP-U is out
# of band; LOCAL Infinispan is correct (no distributed CP session state).
EPC_ROLE_HSS=false
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=false
EPC_ROLE_PCRF=false
EPC_ROLE_PCEF=false
EPC_ROLE_UP=true
EPC_CLUSTER_NODE_ID=epc-up-1
EPC_CLUSTER_ISPN_MODE=LOCAL
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=6
EPC_HTTP_PORT=8099
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# P1 UP dataplane knobs (GTP-U QER/URR). QER (HTB QoS) off by default; URR
# usage reporting defaults to poll mode with baseline counters persisted to PG.
EPC_UP_QER_ENABLED=false
EPC_UP_URR_MODE=poll
EPC_UP_URR_POLL_MS=60000
EPC_UP_URR_BASELINE_PERSIST_MS=300000