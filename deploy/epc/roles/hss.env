# Production HSS/AuC process (same epc-host image). S6a + Cx. No GTP-C.
EPC_ROLE_HSS=true
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=false
EPC_CLUSTER_NODE_ID=epc-hss-1
EPC_CLUSTER_ISPN_MODE=LOCAL
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=1
EPC_HTTP_PORT=8099
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
