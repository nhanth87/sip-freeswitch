# Production HSS/AuC process (same epc-host image). S6a + Cx. No GTP-C.
EPC_ROLE_HSS=true
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=false
EPC_CLUSTER_NODE_ID=epc-hss-1
EPC_CLUSTER_ISPN_MODE=LOCAL
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=1
EPC_HTTP_PORT=8099
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# Outbound Diameter S6a peer = the MME (real peer, not listen-only). For the
# lab attach it is the open5gs MME (docker-compose `mme`, epc profile); the HSS
# dials mme:3868 and the MME's freeDiameter ConnectPeer dials back epc-hss:3868.
EPC_DIAMETER_PEER_HOST=mme
EPC_DIAMETER_PEER_PORT=3868
EPC_DIAMETER_PEER_ROLE=client
# Origin-Host/Realm advertised on CER. Open5GS mme.conf ConnectPeer identity and
# mme.yaml hss_map host MUST equal this Origin-Host (freeDiameter CEA-identity check).
EPC_DIAMETER_ORIGIN_HOST=epc-hss-1.epc.lab
EPC_DIAMETER_ORIGIN_REALM=epc.lab
# Destination-Host/Realm the HSS uses in server-initiated S6a (CLR/IDR/PUR -> MME).
# Matches open5gs mme.conf Identity/Realm = mme.epc.lab / epc.lab.
EPC_DIAMETER_DEST_HOST=mme.epc.lab
EPC_DIAMETER_DEST_REALM=epc.lab
# MME peer-trust drawbridge (Open5GS #4337): reject S6a from non-allowlisted peers.
# Allowlist stays OFF by default; enable + list allowed MME Origin-Host/Realm/PLMN.
EPC_HSS_MME_ALLOWLIST_ENABLED=false
EPC_HSS_MME_ALLOWLIST=
