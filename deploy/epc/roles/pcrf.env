# PCRF — Gx/Rx policy + charging rule engine (same epc-host image). Diameter only; no GTP/PFCP.
# Standalone policy node; keeps no PFCP/GTP-C session state — LOCAL Infinispan is fine.
EPC_ROLE_HSS=false
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=false
EPC_ROLE_PCRF=true
EPC_ROLE_PCEF=false
EPC_ROLE_UP=false
EPC_CLUSTER_NODE_ID=epc-pcrf-1
EPC_CLUSTER_ISPN_MODE=LOCAL
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=4
EPC_HTTP_PORT=8099
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# Gx/Rx are served by the local peer-ready Diameter RA; a real AF/PCF peer is
# configured here (blank keeps listen-only for the lab-only heap path).
EPC_DIAMETER_PEER_ROLE=client
# Outbound Diameter peer = the PGW-C/PCEF node (compose service `epc-pgwc`):
# this PCRF dials it (CER) and peer-live = isPeerReady() (CEA) — never LISTEN.
# PGW-C's WirePcrfClient dials back on the same link (Gx CCR/CCA + RAR push).
EPC_DIAMETER_PEER_HOST=epc-pgwc
EPC_DIAMETER_PEER_PORT=3868
# Origin-Host/Realm advertised on CER — this node's Diameter identity.
EPC_DIAMETER_ORIGIN_HOST=epc-pcrf-1.epc.lab
EPC_DIAMETER_ORIGIN_REALM=epc.lab
# Destination-Host/Realm for this Gx/Rx endpoint: the identity peers address to
# reach this PCRF (PCEF CCR/RAR route), echoed on server-initiated pushes.
EPC_DIAMETER_DEST_HOST=epc-pcrf-1.epc.lab
EPC_DIAMETER_DEST_REALM=epc.lab