# SGW-C — S11 + S5-C + Sxa. Pair 1:1 with sgwu via PFCP.
EPC_ROLE_HSS=false
EPC_ROLE_SGWC=true
EPC_ROLE_PGWC=false
EPC_CLUSTER_NODE_ID=epc-sgwc-1
EPC_CLUSTER_ISPN_MODE=DIST_SYNC
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=1
EPC_HTTP_PORT=8099
EPC_PFCP_PEER_HOST=sgwu
EPC_PFCP_PEER_PORT=8805
# S11 peer = open5gs MME (epc profile `mme`). The MME is our S11 client and also
# answers GTPv2-C Echo on :2123, which this SGW-C's peer watch + gtp-echo-smoke use.
EPC_GTP_PEER_HOST=mme
EPC_GTP_PEER_PORT=2123
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# P1 split S5-C wire knob (SGW-C -> PGW-C GTPv2-C). Off = lab in-process embedded
# default; flip true + point the PGW-C peer to route S5-C on the wire.
EPC_S5C_WIRE=false
EPC_S5C_PGWC_PEER_HOST=epc-pgwc
EPC_S5C_PGWC_PEER_PORT=2123
