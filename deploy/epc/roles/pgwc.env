# PGW-C — S5-C + Sxb + PCEF. Pair 1:1 with pgwu via PFCP.
EPC_ROLE_HSS=false
EPC_ROLE_SGWC=false
EPC_ROLE_PGWC=true
EPC_CLUSTER_NODE_ID=epc-pgwc-1
EPC_CLUSTER_ISPN_MODE=DIST_SYNC
EPC_CLUSTER_ISPN_NAME=epc-cluster
EPC_CLUSTER_NODE_INDEX=2
EPC_HTTP_PORT=8099
EPC_PFCP_PEER_HOST=pgwu
EPC_PFCP_PEER_PORT=8805
EPC_GTP_PEER_HOST=epc-sgwc
EPC_GTP_PEER_PORT=2123
EPC_JDBC_URL=jdbc:postgresql://postgres-epc:5432/epc
# P1 split S5-C listener side (PGW-C). PGW-C accepts S5-C from SGW-C on these;
# host matches sgwc.env EPC_S5C_PGWC_PEER_HOST=epc-pgwc. Off = lab in-process.
EPC_S5C_WIRE=false
EPC_S5C_PGWC_PEER_HOST=epc-sgwc
EPC_S5C_PGWC_PEER_PORT=2123
