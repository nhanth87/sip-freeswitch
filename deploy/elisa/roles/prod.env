# Production P0 overlay — copy to host env / systemd EnvironmentFile.
# Do NOT ship real secrets in git. Missing values must fail closed.

QUARKUS_PROFILE=prod

# Required secrets (fail closed — no lab defaults)
SF_ADMIN_API_KEY=
SF_ADMIN_SESSION_HMAC_SECRET=
SF_ADMIN_BOOTSTRAP_PASSWORD=
SF_ADMIN_DEV_LOGIN=false

# JDBC
SF_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/elisa
SF_DB_USER=elisa
SF_DB_PASSWORD=

# Cluster — multi S-CSCF must be DIST_SYNC
SF_CLUSTER_NODE_ID=elisa-scscf-1
SF_CLUSTER_ISPN_ENABLED=true
SF_CLUSTER_ISPN_MODE=DIST_SYNC
SF_CLUSTER_ISPN_NAME=elisa-cluster

# IMS roles (example: combined or S-only — see roles/*.env)
SF_IMS_ENABLED=true
SF_IMS_FEATURE_MMTEL=true
SF_IMS_FEATURE_CHARGING=false
SF_IMS_FEATURE_ENUM=false

# Charging / OCS — leave off until CGRates + Rf peer grilled
SF_CGRATES_ENABLED=false
SF_CGRATES_CDRS_ENABLED=false
SF_CGRATES_SESSIONS_ENABLED=false
SF_CHARGING_DUAL_WRITE=false
SF_RF_ENABLED=false
SF_OCS_SESSION_ENABLED=false
SF_OCS_MODE=deferred

# ESL / trunk
SF_ESL_HOST=127.0.0.1
SF_ESL_PORT=8021
SF_ESL_PASSWORD=
SF_TRUNK_FREESWITCH_URI=sip:1000@127.0.0.1:5060
